import random
import math

def create_board():
    board = [[0 for j in range(8)] for i in range(8)]

    for col in range(8):
        row = random.randint(0, 7)
        board[row][col] = 1

    return board

def cost(board):
    conflicts = 0

    for i in range(8):
        for j in range(8):
            if board[i][j] == 1:
                for k in range(j + 1, 8):
                    for r in range(8):
                        if board[r][k] == 1:
                            if abs(i - r) == abs(j - k):
                                conflicts += 1

    return conflicts

def simulated_annealing():
    for restart in range(100):
        board = create_board()
        temperature = 100.0

        while temperature > 0.01:
            current_cost = cost(board)

            if current_cost == 0:
                print("Solution found:")
                display(board)
                return

            col = random.randint(0, 7)
            row = random.randint(0, 7)

            while board[row][col] == 1:
                row = random.randint(0, 7)

            new_board = [r[:] for r in board]

            for i in range(8):
                new_board[i][col] = 0

            new_board[row][col] = 1
            new_cost = cost(new_board)
            delta = new_cost - current_cost

            if delta < 0 or random.random() < math.exp(-delta / temperature):
                board = new_board

            temperature *= 0.995

    print("Solution not found. Run again.")

def display(board):
    for row in board:
        print(row)

simulated_annealing()
